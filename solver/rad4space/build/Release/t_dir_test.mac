# quick check: print initial momentum direction of the source
/run/verbose 2
/control/verbose 0
/rad4space/gdml/SetGDMLFile axes.gdml
/rad4space/physics/SetPL FTFP_BERT
/rad4space/physics/SetGlobalCut 0.7 mm
/run/initialize
/gps/particle proton
/gps/ene/type Lin
/gps/ene/min 1. MeV
/gps/ene/max 10. MeV
/gps/ene/gradient 0.
/gps/ene/intercept 1.
/gps/pos/type Point
/gps/pos/centre 0. 0. -30. cm
/gps/direction 0. 0. 1.
/gps/verbose 2
/run/beamOn 3
exit
