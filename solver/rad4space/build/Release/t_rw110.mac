/rad4space/gdml/SetGDMLFile axes.gdml
/rad4space/physics/SetPL FTFP_BERT
/rad4space/physics/SetGlobalCut 0.7 mm
/run/initialize
/gps/particle proton
/gps/ene/type Lin
/gps/ene/min 1. MeV
/gps/ene/max 10. MeV
/gps/pos/type Point
/gps/pos/centre 0. 0. -30. cm
/gps/direction 0. 0. 1.
/score/create/realWorldLogVol vOrigin
/score/quantity/energyDeposit eDep MeV
/score/close
/score/list
/run/beamOn 100
/score/dumpAllQuantitiesToFile vOrigin t_rw110.csv
exit
