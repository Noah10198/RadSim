#########################################################
# mesh_probe.mac : defining a scoring probe + 1-D histogram
#
#   probe (half cube 5 cm at origin)
#     + volumeFlux / energyDeposit primitive scorers
#     + /score/fill1D  -> 1-D histograms (Book 4.9.8)
#
# Usage:
#   rad4space.exe mesh_probe.mac [nThreads]
#########################################################
/run/verbose 1
/control/verbose 1

/rad4space/gdml/SetGDMLFile axes.gdml
/rad4space/physics/SetPL FTFP_BERT
/rad4space/physics/SetGlobalCut 0.7 mm
/run/initialize

# --- primary source : 100 MeV protons along +z ---
/gps/particle proton
/gps/energy 100 MeV
/gps/pos/type Point
/gps/pos/centre 0. 0. -30. cm
/gps/direction 0. 0. 1.

# --- scoring probe (cube half-size 5 cm, centred on origin) ---
/score/create/probe Probes 5. cm
/score/probe/locate 0. 0. 0. cm
/score/quantity/volumeFlux volFlux
/score/quantity/energyDeposit eDep MeV
/score/filter/particle protonFilter proton
/score/close
/score/list

# --- 1-D histograms filled by the probe scorers ---
# /analysis/h1/create <name> <title> <nbins> <xmin> <xmax> <unit> ! log
/analysis/h1/create volFlux Probes_volFlux 100 0.01 2000. MeV ! log
/analysis/h1/create eDep   Probes_eDep   100 0.001 1000. MeV ! log
/score/fill1D 0 Probes volFlux
/score/fill1D 1 Probes eDep

/run/beamOn 100

# --- dump probe integrated quantities ---
/score/dumpAllQuantitiesToFile Probes mesh_probe.csv

exit
