#########################################################
# mesh_realworld.mac : real-world logical volume scoring
#
#   /score/create/realWorldLogVol vOrigin
#     the real geometry volume "vOrigin" (ALU cube at origin)
#     is used as the scoring mesh, with one cell per copy.
#     /score/mesh/ commands do NOT affect this mesh.
#
# Notes on this revision:
#   * sensitive volume changed from "TOP" to "vOrigin":
#     TOP is 1e-24 g/cm^3 gaseous air, so protons deposit
#     ~0 MeV there (edep==0 steps are not recorded by
#     G4PSEnergyDeposit).  vOrigin is ALU (2.7 g/cm^3),
#     where 1-10 MeV protons stop and deposit their energy.
#   * 1-10 MeV uniform spectrum via /gps/ene/type Lin.
#     IMPORTANT: gradient/intercept MUST be set explicitly.
#     They default to 0, and GenerateLinearEnergies() then
#     evaluates 0/0 = NaN in Geant4 11.4.2 (track killed
#     instantly, every scorer reads 0).
#     gradient 0 + intercept 1  => dN/dE = const (uniform).
#     gradient 1 + intercept 0  => dN/dE ~ E (linearly rising).
#   * histogram range 0-10 MeV (not 0-110): the source
#     upper bound is 10 MeV, so 0-110 leaves most bins
#     empty and wastes statistics resolution.
#
# Usage:
#   rad4space.exe mesh_realworld.mac [nThreads]
#########################################################
/run/verbose 1
/control/verbose 1

/rad4space/gdml/SetGDMLFile axes.gdml
/rad4space/physics/SetPL FTFP_BERT
/rad4space/physics/SetGlobalCut 0.7 mm
/run/initialize

# --- primary source : 1-10 MeV uniform proton spectrum along +z ---
/gps/particle proton
/gps/ene/type Lin
/gps/ene/min 1. MeV
/gps/ene/max 10. MeV
/gps/ene/gradient 1.
/gps/ene/intercept 1.
/gps/pos/type Point
/gps/pos/centre 0. 0. -30. cm
/gps/direction 0. 0. 1.

# --- score on the real world logical volume ---
# mesh name == logical volume name ("vOrigin", "vXBox", "vYBox", "vZBox", ...)
/score/create/realWorldLogVol vOrigin
/score/quantity/energyDeposit eDep MeV
/score/quantity/volumeFlux volFlux
/score/close
/score/list

# --- 1-D histograms filled from the realWorldLogVol mesh ---
# linear bins, 0-10 MeV (1-10 MeV protons stop inside vOrigin)
/analysis/h1/create eDep   vOrigin_eDep   10 0. 10. MeV
/analysis/h1/create volFlux vOrigin_volFlux 10 0. 10. MeV
/score/fill1D 0 vOrigin eDep
/score/fill1D 1 vOrigin volFlux

/run/beamOn 100000

# --- dump mesh quantities ---
/score/dumpAllQuantitiesToFile vOrigin 333mesh_realworld.csv

exit
