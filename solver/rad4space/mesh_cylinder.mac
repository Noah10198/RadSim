#########################################################
# mesh_cylinder.mac : cylinderMesh scoring test
#
#   Tube grid: R = 5 cm, half-height Dz = 20 cm
#   bins: Nr=10, Nz=20, Nphi=12  (axis = z)
#   energyDeposit primitive scorer
#   (fill1D does NOT apply to cylinderMesh; use dumpQuantityToFile)
#
# Usage:
#   rad4space.exe mesh_cylinder.mac [nThreads]
#########################################################
/run/verbose 1
/control/verbose 1

/rad4space/gdml/SetGDMLFile axes.gdml
/rad4space/physics/SetPL FTFP_BERT
/rad4space/physics/SetGlobalCut 0.7 mm
/run/initialize

# --- primary source : 100 MeV protons along +z ---
/gps/particle proton
/gps/energy 100 MeV
/gps/pos/type Point
/gps/pos/centre 0. 0. -30. cm
/gps/direction 0. 0. 1.

# --- cylinder mesh (R, half-height Dz; bins Nr Nz Nphi) ---
/score/create/cylinderMesh Cyl
/score/mesh/cylinderSize 5. 20. cm
/score/mesh/nBin 10 20 12
/score/quantity/energyDeposit eDep MeV
/score/close
/score/list

/run/beamOn 100

# --- dump the 3-D grid ---
/score/dumpQuantityToFile Cyl eDep mesh_cylinder_eDep.csv

exit
