#########################################################
# mesh_multi_probe.mac : 4 independent scoring probes
#
# 来源：用户提供的参考范例，验证"一个探针 = 一个 mesh 块"设计
#       （GUI probe 弹窗生成的 mac 即此形态）
#
# Layout along +z (source at z=-30, ALU vOrigin cube at origin):
#   P1(-20) -> P2(-10) -> P3(0, overlaps vOrigin) -> P4(+10)
#
# Expected for 1-10 MeV protons (world AIR is near vacuum):
#   P1/P2 vacuum : volFlux=1/proton, eDep~0
#   P3  in ALU   : all protons stop, eDep = full energy
#   P4  downstream: nothing arrives, all 0
#
# GUI 生成注意（对照 GUI 设计）：
#   1. 每个探针一个 /score/create/probe 块（一个探针 = 一个位置）
#   2. fill1D 的 id 是【全局连续编号】（0..7，按 /analysis/h1/create 顺序），
#      不是每个探针从 0 开始——mac 生成器要维护全局计数器
#   3. filter 只绑定"紧邻其前的 quantity"：本脚本 protonFilter 只过滤了 eDep，
#      volFlux 未过滤；GUI 里每个 quantity 行挂自己的 filter 即可避免
#   4. 本脚本未写 /score/probe/material → 无材料覆盖（= GUI 材料下拉选 none）
#
# Usage: rad4space.exe mesh_multi_probe.mac [nThreads]
#########################################################
/run/verbose 1
/control/verbose 1

/rad4space/gdml/SetGDMLFile axes.gdml
/rad4space/physics/SetPL FTFP_BERT
/rad4space/physics/SetGlobalCut 0.7 mm
/rad4space/analysis/filename mesh_multi_probe
/run/initialize

# --- source : 1-10 MeV uniform proton beam along +z ---
/gps/particle proton
/gps/ene/type Lin
/gps/ene/min 1. MeV
/gps/ene/max 10. MeV
/gps/ene/gradient 0.
/gps/ene/intercept 1.
/gps/pos/type Point
/gps/pos/centre 0. 0. -30. cm
/gps/direction 0. 0. 1.

# --- probe P1 (vacuum, near source) ---
/score/create/probe P1 5. cm
/score/probe/locate 0. 0. -20. cm
/score/quantity/volumeFlux volFlux
/score/quantity/energyDeposit eDep MeV
/score/filter/particle protonFilter proton
/score/close

# --- probe P2 (vacuum, in front of vOrigin) ---
/score/create/probe P2 5. cm
/score/probe/locate 0. 0. -10. cm
/score/quantity/volumeFlux volFlux
/score/quantity/energyDeposit eDep MeV
/score/filter/particle protonFilter proton
/score/close

# --- probe P3 (overlaps the ALU vOrigin cube) ---
/score/create/probe P3 5. cm
/score/probe/locate 0. 0. 0. cm
/score/quantity/volumeFlux volFlux
/score/quantity/energyDeposit eDep MeV
/score/filter/particle protonFilter proton
/score/close

# --- probe P4 (downstream of vOrigin) ---
/score/create/probe P4 5. cm
/score/probe/locate 0. 0. 10. cm
/score/quantity/volumeFlux volFlux
/score/quantity/energyDeposit eDep MeV
/score/filter/particle protonFilter proton
/score/close

/score/list

# --- 1-D histograms, ids follow creation order 0..7 ---
/analysis/h1/create P1_volFlux P1_volFlux 100 0.01 2000. MeV ! log
/analysis/h1/create P1_eDep   P1_eDep   100 0.001 1000. MeV ! log
/analysis/h1/create P2_volFlux P2_volFlux 100 0.01 2000. MeV ! log
/analysis/h1/create P2_eDep   P2_eDep   100 0.001 1000. MeV ! log
/analysis/h1/create P3_volFlux P3_volFlux 100 0.01 2000. MeV ! log
/analysis/h1/create P3_eDep   P3_eDep   100 0.001 1000. MeV ! log
/analysis/h1/create P4_volFlux P4_volFlux 100 0.01 2000. MeV ! log
/analysis/h1/create P4_eDep   P4_eDep   100 0.001 1000. MeV ! log

/score/fill1D 0 P1 volFlux
/score/fill1D 1 P1 eDep
/score/fill1D 2 P2 volFlux
/score/fill1D 3 P2 eDep
/score/fill1D 4 P3 volFlux
/score/fill1D 5 P3 eDep
/score/fill1D 6 P4 volFlux
/score/fill1D 7 P4 eDep

/run/beamOn 1000

# --- per-probe integrated dumps ---
/score/dumpAllQuantitiesToFile P1 mesh_multi_probe_P1.csv
/score/dumpAllQuantitiesToFile P2 mesh_multi_probe_P2.csv
/score/dumpAllQuantitiesToFile P3 mesh_multi_probe_P3.csv
/score/dumpAllQuantitiesToFile P4 mesh_multi_probe_P4.csv

exit
