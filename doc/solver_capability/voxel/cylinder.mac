#########################################################
# voxel 模板：柱坐标网格（cylinderMesh）— 后续扩展
# 用途：轴向柱形结构（如屏蔽壳）用柱坐标体素场
#
# GUI 参数映射：
#   {GDML_FILE}   → /rad4space/gdml/SetGDMLFile
#   {PHYS_LIST}   → /rad4space/physics/SetPL
#   {CUT_MM}      → /rad4space/physics/SetGlobalCut
#   {PARTICLE}    → /gps/particle
#   {ENERGY_SPEC} → 单能 /gps/energy 或 Lin 或 User hist
#   {RADIUS}      → /score/mesh/cylinderSize  (半径, cm)
#   {HALF_DZ}     → /score/mesh/cylinderSize  (半高, cm)
#   {NBIN_R/Z/P}  → /score/mesh/nBin  (径向 / 轴向 / 角向)
#   {QUANTITIES}  → /score/quantity/<primitive> 行
#   {N_EVENTS}    → /run/beamOn
#   {OUT_CSV}     → /score/dumpQuantityToFile
#
# 注意：同 boxMesh，不支持 fill1D；体素坐标是柱坐标 (r, z, phi) 索引。
#########################################################
/run/verbose 1
/control/verbose 1

# --- 几何 & 物理 (PreInit) ---
/rad4space/gdml/SetGDMLFile {GDML_FILE}
/rad4space/physics/SetPL {PHYS_LIST}
/rad4space/physics/SetGlobalCut {CUT_MM} mm
/run/initialize

# --- 粒子源 ---
/gps/particle {PARTICLE}
/gps/energy {ENERGY_MEV} MeV
/gps/pos/type Point
/gps/pos/centre {PX} {PY} {PZ} cm
/gps/direction {DX} {DY} {DZ}

# --- 柱坐标网格 (轴 = z) ---
/score/create/cylinderMesh {MESH_NAME}
/score/mesh/cylinderSize {RADIUS} {HALF_DZ} cm
/score/mesh/nBin {NBIN_R} {NBIN_Z} {NBIN_PHI}
/score/quantity/energyDeposit eDep MeV
/score/close
/score/list

# --- 运行 & 导出 ---
/run/beamOn {N_EVENTS}
/score/dumpQuantityToFile {MESH_NAME} eDep {OUT_CSV}
exit
