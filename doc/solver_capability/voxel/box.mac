#########################################################
# voxel 模板：直角网格（boxMesh）
# 用途：用户在 GUI 选择网格类型/范围/nBin + quantity + filter
#
# GUI 参数映射：
#   {GDML_FILE}   → /rad4space/gdml/SetGDMLFile
#   {PHYS_LIST}   → /rad4space/physics/SetPL
#   {CUT_MM}      → /rad4space/physics/SetGlobalCut
#   {PARTICLE}    → /gps/particle
#   {ENERGY_SPEC} → 单能 /gps/energy 或 Lin 或 User hist
#   {HALF_X/Y/Z}  → /score/mesh/boxSize  (半尺寸，cm)
#   {NBIN_X/Y/Z}  → /score/mesh/nBin
#   {TRANSLATE}   → /score/mesh/translate x y z cm   (可选，box 中心偏移)
#   {QUANTITIES}  → /score/quantity/<primitive> 行
#   {FILTERS}     → /score/filter/* 行（必须紧跟其 target quantity 之后，见 README §5）
#   {N_EVENTS}    → /run/beamOn
#   {OUT_CSV}     → /score/dumpQuantityToFile
#
# 注意：boxMesh 不支持 fill1D（无能谱），只能 dumpQuantityToFile 出体素场。
#       "包围整个场景"  → HALF = 场景包围盒半尺寸，TRANSLATE = 场景中心
#       "包围选中几何"  → HALF = 该几何包围盒半尺寸，TRANSLATE = 其中心
#########################################################
/run/verbose 1
/control/verbose 1

# --- 几何 & 物理 (PreInit) ---
/rad4space/gdml/SetGDMLFile {GDML_FILE}
/rad4space/physics/SetPL {PHYS_LIST}
/rad4space/physics/SetGlobalCut {CUT_MM} mm
/run/initialize

# --- 粒子源 ---
/gps/particle {PARTICLE}
/gps/energy {ENERGY_MEV} MeV
/gps/pos/type Point
/gps/pos/centre {PX} {PY} {PZ} cm
/gps/direction {DX} {DY} {DZ}

# --- 直角网格 ---
/score/create/boxMesh {MESH_NAME}
/score/mesh/boxSize {HALF_X} {HALF_Y} {HALF_Z} cm
/score/mesh/nBin {NBIN_X} {NBIN_Y} {NBIN_Z}
# /score/mesh/translate {TX} {TY} {TZ} cm          # 可选偏移
/score/quantity/energyDeposit eDep MeV
# /score/quantity/volumeFlux volFlux
# /score/filter/particle protonFilter proton       # filter 紧跟 target → 只绑 eDep
/score/close
/score/list

# --- 运行 & 导出 ---
/run/beamOn {N_EVENTS}
/score/dumpQuantityToFile {MESH_NAME} eDep {OUT_CSV}
exit
